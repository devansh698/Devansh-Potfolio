# Public Web3Forms access key (https://web3forms.com) for the contact form.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Canonical origin used for canonical URLs, sitemap, robots, Open Graph and JSON-LD (no trailing slash).
# Optional on Vercel: falls back to the project's production domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional search-console ownership tokens (rendered as <meta> verification tags).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
